# Staging environment variables — copy to .env.staging and fill in
# DO NOT commit the real .env.staging file

# --- Spring profile (used by docker-compose.staging.yml) ---
SPRING_PROFILE=staging

# --- MySQL staging ---
MYSQL_ROOT_PASSWORD=<staging-root-password>
MYSQL_DATABASE=hospital_scheduler
MYSQL_USER=<staging-user>
MYSQL_PASSWORD=<staging-password>
MYSQL_PORT=3306

# --- Backend / Spring Boot ---
BACKEND_PORT=8080
JWT_SECRET=<secret-min-32-chars-change-me>
JWT_EXPIRATION=86400000
LOG_LEVEL=INFO

# --- Email (SMTP for conflict alerts) ---
MAIL_HOST=smtp.staging.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@hospital-scheduler.example.com
MAIL_PASSWORD=<smtp-password>
APP_EMAIL_ENABLED=true
APP_EMAIL_FROM=noreply@hospital-scheduler.example.com
APP_EMAIL_CONFLICT_ENABLED=true

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://staging-api.hospital-scheduler.example.com/api/v1
NEXT_PUBLIC_WS_URL=wss://staging-api.hospital-scheduler.example.com/ws

# --- E2E smoke tests ---
E2E_USERNAME=admin
E2E_PASSWORD=<staging-admin-password>
E2E_LOGIN_PATH=/login

# Email / SMTP Configuration
# Copy this file to .env and fill in your values

# ============================================
# SMTP SETTINGS (Gmail example below)
# For Gmail: Enable 2FA, then create an App Password
# https://support.google.com/accounts/answer/185833
# ============================================

# Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Alternative: Outlook/Office 365
# MAIL_HOST=smtp-mail.outlook.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@outlook.com
# MAIL_PASSWORD=your-password

# Alternative: Zoho Mail
# MAIL_HOST=smtp.zoho.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@zoho.com
# MAIL_PASSWORD=your-password

# ============================================
# APP EMAIL SETTINGS
# ============================================

# Enable/disable all email notifications
APP_EMAIL_ENABLED=false

# The "From" address shown in emails
APP_EMAIL_FROM=noreply@hospital-scheduler.com

# Enable conflict alert emails (sent when schedule conflicts are detected)
APP_EMAIL_CONFLICT_ENABLED=false

# ============================================
# SMTP AUTHENTICATION
# ============================================
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true

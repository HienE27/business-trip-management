{
  "project": {
    "name": "hospital-scheduler",
    "description": "Hệ thống Quản lý Lịch Công Tác",
    "version": "1.1",
    "repository": "https://github.com/tmHieu20-02/business-trip-management"
  },
  "features": {
    "developerMode": true,
    "verbose": true,
    "dangerouslyDisablePoisoning": false
  },
  "permissions": {
    "allowDangerousActions": true,
    "allowAutomaticCommandExecution": true
  },
  "projectMetadata": {
    "database": "hospital_scheduler",
    "tables": [
      "staff", "specialty", "schedule", "shift_type",
      "compensation_day", "schedule_exchange", "leave_request",
      "schedule_conflict", "notification", "audit_history"
    ],
    "modules": ["M01", "M02", "M03", "M04", "M05", "M06", "M07"]
  },
  "customCommands": [
    {
      "name": "check-conflict",
      "description": "Kiểm tra xung đột lịch cho nhân sự"
    },
    {
      "name": "gen-api",
      "description": "Tạo REST API endpoint"
    },
    {
      "name": "validate-schedule",
      "description": "Validate lịch theo business rules"
    }
  ],
  "env": {
    "JAVA_VERSION": "17",
    "SPRING_BOOT_VERSION": "3.x"
  }
}

# ============================================================
# Hospital Scheduler - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to source control
# ============================================================

# ── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_scheduler
DB_USERNAME=root
DB_PASSWORD=your_password_here

# ── Server ─────────────────────────────────────────────────
SERVER_PORT=8080

# ── JWT Authentication ──────────────────────────────────────
# Generate with: openssl rand -base64 32
# IMPORTANT: Change this in production!
JWT_SECRET=Ym9va2NhbXBzZWNyZXRrZXlmb3Jqd3R0b2tlbndpdGhBdExlYXN0MzJjaGFycw==
JWT_EXPIRATION=86400000  # 24 hours in milliseconds

# ── Email (optional) ──────────────────────────────────────
APP_EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
APP_EMAIL_FROM=noreply@hospital-scheduler.com

# ── Security ───────────────────────────────────────────────
# Set to false in development to avoid rate-limiting during testing
RATE_LIMIT_ENABLED=true

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN

# ── SQL Debugging (dev only) ──────────────────────────────
SHOW_SQL=false
FORMAT_SQL=false

# ── Cookie ────────────────────────────────────────────────
# Set to true in production (HTTPS)
COOKIE_SECURE=false

# ── Docker / Production ───────────────────────────────────
# SPRING_PROFILES_ACTIVE=production
# JWT_SECRET=<generate-new-secret>
# DB_HOST=<production-db-host>
# DB_PASSWORD=<production-db-password>

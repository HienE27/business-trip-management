# Hospital Scheduler — Production Environment Variables
# Copy this file to .env.production.local and fill in real values.
# DO NOT commit .env.production.local to version control.

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.staging.hospital-scheduler.example.com/api/v1

# WebSocket STOMP endpoint (ws:// for HTTP, wss:// for HTTPS)
NEXT_PUBLIC_WS_URL=wss://api.staging.hospital-scheduler.example.com/ws
